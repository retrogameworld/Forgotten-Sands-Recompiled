+{
+    Unknown,
+    FPU,
+    VMX
+};
+
+struct Recompiler
+{
+    // Enforce In-order Execution of I/O constant for quick comparison
+    static constexpr uint32_t c_eieio = 0xAC06007C;
+    Image image;
+    std::vector<Function> functions;
+    std::string out;
+    size_t cppFileIndex = 0;
+    RecompilerConfig config;
+
+    // Torchlight Step 11 (safe_locals): functions that must keep all registers in ctx, and the
+    // switches for the function being emitted.
+    std::unordered_set<uint32_t> ctxOnlyFunctions;
+    bool fnNonArgLocals = false;
+    bool fnNonVolatileLocals = false;
+    void AnalyseLocalSafety();
+
+    bool LoadConfig(const std::string_view& configFilePath);
+
+    template<class... Args>
+    void print(fmt::format_string<Args...> fmt, Args&&... args)
