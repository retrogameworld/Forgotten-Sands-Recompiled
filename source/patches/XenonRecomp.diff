+                // code the in-function control flow does not reach. With a computed jump (bctr without a
+                // switch table) its register state is unknown, so a register read there counts as
+                // read-before-write. Without one it is only entered by exception dispatch (__except
+                // blocks, e.g. in __RTDynamicCast), which never runs in this game (no RtlRaiseException).
+                if (computedJump && in.nReads > 0 && !(in.nReads == 1 && in.save))
+                {
+                    if (!rbw[i]) reasons[2]++;
+                    rbw[i] = 1;
+                    if (why[i].empty()) why[i] = fmt::format(" unreached {:X}", fn.base + k * 4);
+                }
+                continue;
+            }
+            for (int t = 0; t < in.nReads; t++)
+            {
+                const int key = in.reads[t];
+                const bool unwritten = !inW[k].test(key);
+                const bool clobbered = inC[k].test(key);
+                if (!unwritten && !clobbered) continue;
+                if (t == 0 && in.save && unwritten) continue;
+                if (why[i].empty())
+                {
+                    ppc_insn insn;
+                    ppc::Disassemble(insData + k, 4, uint32_t(fn.base + k * 4), insn);
+                    why[i] = fmt::format(" {} {:X} {} {}", unwritten ? "rbw" : "vol", fn.base + k * 4, insn.opcode ? insn.opcode->name : "?", insn.op_str);
+                }
+                if (unwritten)
+                    rbw[i] = 1;
+                else
+                {
+                    ctxOnly[i] = 1, reasons[1]++;
+                    if (lastCall >= 0)
+                    {
+                        const int64_t callee = containing(targets[i][size_t(lastCall)]);
+                        if (callee >= 0) ctxOnly[size_t(callee)] = 1;
+                    }
+                }
+            }
+        }
+    }
+
+    size_t rbwCount = 0;
+    for (size_t i = 0; i < functions.size(); i++)
+        if (rbw[i]) { ctxOnly[i] = 1; rbwCount++; }
+    reasons[0] = rbwCount;
+    // callers / branchers of the functions that read registers they did not write
+    size_t propagated = 0;
+    std::unordered_map<size_t, size_t> blame; // function -> callers it made ctx-only
+    for (size_t i = 0; i < functions.size(); i++)
+    {
+        if (ctxOnly[i]) continue;
+        for (uint32_t t : targets[i])
+        {
+            const int64_t j = containing(t);
+            if (j < 0) continue;
+            const bool mid = uint32_t(functions[size_t(j)].base) != t; // a jump into the middle of another function
+            // calls of the __save* / __rest* register helpers are left out of local functions entirely
+            auto sym = image.symbols.find(functions[size_t(j)].base);
+            if (!mid && sym != image.symbols.end() && (sym->name.find("__save") == 0 || sym->name.find("__rest") == 0))
+                continue;
+            if (rbw[size_t(j)] || mid)
+            {
+                blame[size_t(j)]++;
+                ctxOnly[i] = 1;
+                if (mid) ctxOnly[size_t(j)] = 1;
+                propagated++;
+                break;
+            }
+        }
+    }
+
+    ctxOnlyFunctions.clear();
+    for (size_t i = 0; i < functions.size(); i++)
+        if (ctxOnly[i]) ctxOnlyFunctions.insert(uint32_t(functions[i].base));
+    fmt::println("safe_locals: {} of {} functions keep registers in ctx (read-before-write {}, volatile after call {}, "
+        "callers {}, helpers {}, SEH/local unwind {}, setjmp {})", ctxOnlyFunctions.size(), functions.size(), reasons[0], reasons[1],
+        propagated, reasons[3], reasons[4], reasons[5]);
+
+    // list for review
+    std::string list;
+    {
+        std::vector<std::pair<size_t, size_t>> top(blame.begin(), blame.end());
+        std::sort(top.begin(), top.end(), [](auto& a, auto& b) { return a.second > b.second; });
+        for (size_t k = 0; k < top.size() && k < 40; k++)
+            list += fmt::format("# blame {:X}: {} callers{}\n", functions[top[k].first].base, top[k].second, why[top[k].first]);
+    }
+    for (size_t i = 0; i < functions.size(); i++)
+        if (ctxOnly[i]) list += fmt::format("{:X}{}\n", functions[i].base, why[i]);
+    std::string directoryPath = config.directoryPath;
+    if (!directoryPath.empty()) directoryPath += "/";
+    FILE* f = fopen(fmt::format("{}{}/safe_locals_ctx_only.txt", directoryPath, config.outDirectoryPath).c_str(), "wb");
+    if (f) { fwrite(list.data(), 1, list.size(), f); fclose(f); }
+}
